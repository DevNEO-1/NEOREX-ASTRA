# ==============================================================================
# NEOREX ASTRA — Environment Configuration Register
# NASA Space Apps Challenge 2026
# Copy this file to .env and insert your real Gemini API Key.
# DO NOT COMMIT THE ACTUAL .env FILE OR ANY SECRETS TO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
# HTTP port for the Dr. Astra backend service
PORT=3001

# Network interface to bind. Use 0.0.0.0 for cloud/containers (Render, Docker, Cloud Run)
# or 127.0.0.1 for local-only development.
HOST=0.0.0.0

# Server execution environment: development | production | test
NODE_ENV=development

# Official Google Gemini API Key (Required for live AI responses)
# Keep strictly server-side. Never expose in frontend build or client bundles.
# If absent or invalid, Dr. Astra gracefully falls back to deterministic guidance.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Official Google Gemini Model ID
# Recommended models: gemini-2.5-flash (default, low latency) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated list of permitted frontend origins)
# Both ALLOWED_ORIGIN and ALLOWED_ORIGINS are supported.
# In production, requests from unlisted origins will be rejected with HTTP 403.
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite / React)
# ------------------------------------------------------------------------------
# Base URL of the Dr. Astra Gemini backend.
# - Leave blank ("") to use same-origin relative URL (/api/dr-astra/chat) with Vite dev proxy or reverse proxy.
# - In split deployments (e.g. Vercel frontend + Render backend), set to public backend URL (e.g. https://dr-astra-api.onrender.com).
# Non-secret client environment variable.
VITE_DR_ASTRA_BACKEND_URL=

# Development reverse-proxy target for Vite (optional, defaults to http://localhost:3001)
VITE_DEV_BACKEND_TARGET=http://localhost:3001
