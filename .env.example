# NEOREX ASTRA — Dr. Astra Gemini Backend Environment Configuration
# Copy this file to .env and insert your real Gemini API Key.
# DO NOT COMMIT THE ACTUAL .env FILE!

PORT=3001
HOST=127.0.0.1
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
